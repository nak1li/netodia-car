<?xml version="1.0" encoding="utf-8"?>
<!--
  车机主界面 v2（1024x600 mdpi 设计，按 220:532:272 权重自适应）：
  上部三栏（高度 = 屏高 - 104dp 底栏），下部 104dp 常驻控制条。
  左：功能入口    中：列表（头 56 + 行 72）    右：正在播放 + 歌词
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E1116"
    android:fitsSystemWindows="true">

    <!-- ================= 上部三栏 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- = 左栏 220：功能入口 = -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="220"
            android:orientation="vertical"
            android:background="#141922"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="音 乐"
                android:textColor="#7D8896"
                android:textSize="13sp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="10dp" />

            <!-- 4 个入口由代码 inflate item_nav.xml 填进来（选中态要逐项改色）。
                 套一层 ScrollView：1024x600 下它就是那段留白；万一车机是 800x480
                 也不会把「设置」挤到屏幕外（四个入口 4*84dp 仍然放得下，只是列表可滚）。 -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/nav_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/nav_settings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/nav_item_normal"
                android:gravity="center_vertical"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:text="设置"
                android:textColor="#7D8896"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- = 中栏 532：列表 = -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="532"
            android:orientation="vertical"
            android:background="#0E1116">

            <!-- 列表头 56dp：标题 24sp bold + 右侧附加信息 15sp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp">

                <TextView
                    android:id="@+id/list_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="每日推荐"
                    android:textColor="#E6EAF2"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/list_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:gravity="right|center_vertical"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text=""
                    android:textColor="#7D8896"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2530" />

            <!-- 列表 + 居中提示（提示浮在空列表上） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/song_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="#1E2530"
                    android:dividerHeight="1dp"
                    android:scrollbarStyle="outsideOverlay" />

                <TextView
                    android:id="@+id/empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="#7D8896"
                    android:textSize="17sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- = 右栏 272：正在播放 = -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="272"
            android:orientation="vertical"
            android:background="#141922"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tag_info"
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="#7FA9FF"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="206dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerInside"
                android:contentDescription="封面"
                android:src="@drawable/cover_placeholder" />

            <TextView
                android:id="@+id/now_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="未在播放"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/now_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:textColor="#A9B4C4"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/now_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:textColor="#7D8896"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#1E2530" />

            <!-- 歌词区：点它（或点封面）切换封面显隐 -->
            <ScrollView
                android:id="@+id/lyric_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="12dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/lyric_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.55"
                    android:text=""
                    android:textColor="#7D8896"
                    android:textSize="16sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 底部常驻控制条 104dp ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bar_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:id="@+id/btn_prev"
            android:layout_width="96dp"
            android:layout_height="80dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/btn_dark"
            android:src="@drawable/ic_prev"
            android:scaleType="center"
            android:contentDescription="上一首" />

        <ImageView
            android:id="@+id/btn_play"
            android:layout_width="124dp"
            android:layout_height="80dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/btn_primary"
            android:src="@drawable/ic_play"
            android:scaleType="center"
            android:contentDescription="播放/暂停" />

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="96dp"
            android:layout_height="80dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/btn_dark"
            android:src="@drawable/ic_next"
            android:scaleType="center"
            android:contentDescription="下一首" />

        <TextView
            android:id="@+id/btn_like"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/heart_off"
            android:gravity="center"
            android:text="♥"
            android:textColor="#3A4554"
            android:textSize="30sp" />

        <!-- 进度区：当前时间 48 + SeekBar(flex) + 总时长 48 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/time_position"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:singleLine="true"
                android:text="00:00"
                android:textColor="#7D8896"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:max="1000"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:progressDrawable="@drawable/seek_progress"
                android:thumb="@drawable/seek_thumb" />

            <TextView
                android:id="@+id/time_duration"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="right|center_vertical"
                android:singleLine="true"
                android:text="00:00"
                android:textColor="#7D8896"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
